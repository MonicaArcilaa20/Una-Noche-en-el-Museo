# Unity .gitattributes - versión corregida y simplificada
# Proyecto Unity + GitHub Desktop + Git LFS controlado

# =========================
# Código y texto
# =========================
*.cs                    text diff=csharp
*.shader                text
*.compute               text linguist-language=hlsl
*.hlsl                  text linguist-language=hlsl
*.cginc                 text
*.raytrace              text linguist-language=hlsl

# =========================
# Unity JSON
# =========================
*.asmdef                text eol=lf linguist-language=json
*.asmref                text eol=lf linguist-language=json
*.index                 text eol=lf linguist-language=json
*.inputactions          text eol=lf linguist-language=json
*.shadergraph           text eol=lf linguist-language=json
*.shadersubgraph        text eol=lf linguist-language=json

# =========================
# UI Toolkit
# =========================
*.tss                   text diff=css linguist-language=css
*.uss                   text diff=css linguist-language=css
*.uxml                  text linguist-language=xml linguist-detectable

# =========================
# Unity YAML - NO LFS
# =========================
*.anim                  text eol=lf linguist-language=yaml
*.asset                 text eol=lf linguist-language=yaml
*.brush                 text eol=lf linguist-language=yaml
*.controller            text eol=lf linguist-language=yaml
*.flare                 text eol=lf linguist-language=yaml
*.fontsettings          text eol=lf linguist-language=yaml
*.giparams              text eol=lf linguist-language=yaml
*.guiskin               text eol=lf linguist-language=yaml
*.lighting              text eol=lf linguist-language=yaml
*.mask                  text eol=lf linguist-language=yaml
*.mat                   text eol=lf linguist-language=yaml
*.meta                  text eol=lf linguist-language=yaml
*.mixer                 text eol=lf linguist-language=yaml
*.overrideController    text eol=lf linguist-language=yaml
*.playable              text eol=lf linguist-language=yaml
*.prefab                text eol=lf linguist-language=yaml
*.preset                text eol=lf linguist-language=yaml
*.renderTexture         text eol=lf linguist-language=yaml
*.scenetemplate         text eol=lf linguist-language=yaml
*.shadervariants        text eol=lf linguist-language=yaml
*.signal                text eol=lf linguist-language=yaml
*.spriteatlas           text eol=lf linguist-language=yaml
*.spriteatlasv2         text eol=lf linguist-language=yaml
*.terrainlayer          text eol=lf linguist-language=yaml
*.unity                 text eol=lf linguist-language=yaml
*.physicMaterial        text eol=lf linguist-language=yaml
*.physicsMaterial2D     text eol=lf linguist-language=yaml

# =========================
# Git LFS SOLO para archivos pesados
# =========================

# Unity packages
*.unitypackage          filter=lfs diff=lfs merge=lfs -text

# Modelos 3D pesados
*.fbx                   filter=lfs diff=lfs merge=lfs -text
*.FBX                   filter=lfs diff=lfs merge=lfs -text
*.blend                 filter=lfs diff=lfs merge=lfs -text
*.obj                   filter=lfs diff=lfs merge=lfs -text
*.dae                   filter=lfs diff=lfs merge=lfs -text
*.3ds                   filter=lfs diff=lfs merge=lfs -text
*.stl                   filter=lfs diff=lfs merge=lfs -text

# Audio pesado
*.wav                   filter=lfs diff=lfs merge=lfs -text

# Video pesado
*.mp4                   filter=lfs diff=lfs merge=lfs -text
*.mov                   filter=lfs diff=lfs merge=lfs -text

# Archivos fuente pesados de diseño
*.psd                   filter=lfs diff=lfs merge=lfs -text
*.tif                   filter=lfs diff=lfs merge=lfs -text
*.tiff                  filter=lfs diff=lfs merge=lfs -text
*.exr                   filter=lfs diff=lfs merge=lfs -text
*.hdr                   filter=lfs diff=lfs merge=lfs -text

# Comprimidos pesados
*.zip                   filter=lfs diff=lfs merge=lfs -text
*.rar                   filter=lfs diff=lfs merge=lfs -text
*.7z                    filter=lfs diff=lfs merge=lfs -text

# =========================
# Archivos generados / estadísticas
# =========================
Assets/Plugins/**           linguist-generated
Packages/packages-lock.json linguist-generated
